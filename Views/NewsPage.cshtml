@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.PublishedContent
@using BellaVista.Helpers
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "Master.cshtml";
    string lang = LanguageHelper.ResolveLangCode(Context);
    var culture = LanguageHelper.ToCultureInfo(lang);
    string Dict(string key) => Umbraco.GetDictionaryValue(key, culture);
    string heroHeading = LanguageHelper.Pick(lang, Model.Value<string>("heroHeading"), Model.Value<string>("heroHeadingEn"), Model.Value<string>("heroHeadingAr")) is { Length: > 0 } h ? h : Dict("Nav.News");
    string intro = LanguageHelper.Pick(lang, Model.Value<string>("intro"), Model.Value<string>("introEn"), Model.Value<string>("introAr"));
}
<div class="main_bg">
    <div class="container">
        <div class="main_grid1">
            <h3 class="style pull-left">@heroHeading</h3>
            <ol class="breadcrumb pull-right">
                <li><a href="/">@Dict("Nav.Home")</a></li>
                <li class="active">@heroHeading</li>
            </ol>
            <div class="clearfix"></div>
        </div>
    </div>
</div>
<div class="main_btm1">
    <div class="container">
        @if (!string.IsNullOrEmpty(intro))
        {
            <p class="menu-intro">@intro</p>
        }
        <div class="blog">
            <div class="blog_main col-md-12">
                @foreach (IPublishedContent item in Model.Children("newsItem").OrderByDescending(n => n.CreateDate))
                {
                    var thumb = item.Value<MediaWithCrops>("thumbnail");
                    string itemTeaser = LanguageHelper.Pick(lang, item.Value<string>("teaser"), item.Value<string>("teaserEn"), item.Value<string>("teaserAr"));
                    <div class="blog_list">
                        <div class="col-md-2 blog_date">
                            <span class="date">@item.CreateDate.ToString("MMM")<p>@item.CreateDate.ToString("dd")<p></p></span>
                            <span class="icon_date"><i class="fa fa-newspaper-o"></i></span>
                        </div>
                        <div class="col-md-10 blog_left">
                            @if (thumb != null)
                            {
                                <a href="@item.Url()"><img src="@thumb.Content.Url()" alt="" class="img-responsive" /></a>
                            }
                            <h4 dir="ltr"><a href="@item.Url()">@item.Name</a></h4>
                            <p class="para">@itemTeaser</p>
                            <div class="read_btn">
                                <a href="@item.Url()"><button class="btn">@Dict("Btn.ReadMore")</button></a>
                            </div>
                        </div>
                        <div class="clearfix"></div>
                    </div>
                }
            </div>
            <div class="clearfix"></div>
        </div>
    </div>
</div>