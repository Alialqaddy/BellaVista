@using BellaVista.Helpers
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "Master.cshtml";
    string lang = LanguageHelper.ResolveLangCode(Context);
    var culture = LanguageHelper.ToCultureInfo(lang);
    string Dict(string key) => Umbraco.GetDictionaryValue(key, culture);
    string heroHeading = Model.Value<string>("heroHeading") ?? Dict("Nav.Gallery");
}
<div class="main_bg">
    <div class="container">
        <div class="main_grid1">
            <h3 class="style pull-left">@heroHeading</h3>
            <ol class="breadcrumb pull-right">
                <li><a href="/">@Dict("Nav.Home")</a></li>
                <li class="active">@heroHeading</li>
            </ol>
            <div class="clearfix"></div>
        </div>
    </div>
</div>
<div class="main_btm1">
    <div class="container">
        <div class="portfolio_main">
            <ul id="filters" class="clearfix">
                <li><span class="filter active" data-filter="starter main dessert drink">@Dict("Gallery.FilterAll")</span></li>
                <li><span class="filter" data-filter="starter">@Dict("Gallery.FilterStarters")</span></li>
                <li><span class="filter" data-filter="main">@Dict("Gallery.FilterMains")</span></li>
                <li><span class="filter" data-filter="dessert">@Dict("Gallery.FilterDesserts")</span></li>
                <li><span class="filter" data-filter="drink">@Dict("Gallery.FilterDrinks")</span></li>
            </ul>
            <div id="portfoliolist" dir="ltr">
                @* Block List rendering, chapter 4 (Element-Types und Blocklist) *@
                @await Html.GetBlockListHtmlAsync(Model, "images")
            </div>
            <div class="clearfix"></div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        $(function () {
            $('#portfoliolist').mixitup({
                targetSelector: '.portfolio',
                filterSelector: '.filter',
                effects: ['fade'],
                easing: 'snap'
            });
        });
    </script>
}