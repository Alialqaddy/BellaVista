@using System.Globalization
@using Microsoft.AspNetCore.Http
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Cms.Core.Security
@using BellaVista.Helpers
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@inject IMemberManager MemberManager
@{
    Layout = null;

    // -- language switcher (Übung 7.1/7.2): plain text links in the main nav, remembered in a
    // cookie so it sticks across pages, read consistently everywhere via LanguageHelper --
    string lang = LanguageHelper.ResolveLangCode(Context);

    // -- SEO composition (chapter 2 / "reusable SEO composition") - fully translated (DE/EN/AR) --
    string pageTitle = LanguageHelper.Pick(lang,
        Model.HasValue("pageTitle") ? Model.Value<string>("pageTitle") : Model.Name,
        Model.Value<string>("pageTitleEn"), Model.Value<string>("pageTitleAr"));
    string titleAppend = LanguageHelper.Pick(lang,
        Model.Value<string>("titleAppend", fallback: Fallback.ToAncestors),
        Model.Value<string>("titleAppendEn", fallback: Fallback.ToAncestors),
        Model.Value<string>("titleAppendAr", fallback: Fallback.ToAncestors));
    string metaDescription = LanguageHelper.Pick(lang, Model.Value<string>("metaDescription"), Model.Value<string>("metaDescriptionEn"), Model.Value<string>("metaDescriptionAr"));
    string metaKeywords = Model.Value<string>("metaKeywords") ?? "";
    string? queryLang = Context.Request.Query["lang"].FirstOrDefault();
    string cookieLang = Context.Request.Cookies["bv_lang"] ?? LanguageHelper.DefaultLangCode;
    if (queryLang != null && queryLang != cookieLang)
    {
        Context.Response.Cookies.Append("bv_lang", lang, new CookieOptions { Expires = DateTimeOffset.UtcNow.AddYears(1) });
    }
    CultureInfo culture = LanguageHelper.ToCultureInfo(lang);
    bool isRtl = LanguageHelper.IsRtl(lang);
    string Dict(string key) => Umbraco.GetDictionaryValue(key, culture);

    IEnumerable<IPublishedContent> latestNews = Model.Root()
        .Descendants("newsItem")
        .OrderByDescending(n => n.CreateDate)
        .Take(2);
}
