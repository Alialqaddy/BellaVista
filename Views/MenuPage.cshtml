@using Umbraco.Cms.Core.Models.PublishedContent
@using BellaVista.Helpers
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@inject IVariationContextAccessor VariationContextAccessor
@{
    Layout = "Master.cshtml";
    string lang = LanguageHelper.ResolveLangCode(VariationContextAccessor);
    var culture = LanguageHelper.ToCultureInfo(lang);
    string Dict(string key) => Umbraco.GetDictionaryValue(key, culture);
    string heroHeading = Model.Value<string>("heroHeading") is { Length: > 0 } h ? h : Dict("Nav.Menu");
    string intro = Model.Value<string>("intro") ?? "";
}
<div class="main_bg">
    <div class="container">
        <div class="main_grid1">
            <h3 class="style pull-left">@heroHeading</h3>
            <ol class="breadcrumb pull-right">
                <li><a href="@Model.Root().Url()">@Dict("Nav.Home")</a></li>
                <li class="active">@heroHeading</li>
            </ol>
            <div class="clearfix"></div>
        </div>
    </div>
</div>
<div class="main_btm1">
    <div class="container">
        @if (!string.IsNullOrEmpty(intro))
        {
            <p class="menu-intro">@intro</p>
        }
        @* Blockgrid rendering exactly as taught: chapter 5, Übung 5.1.
           Direction scoping for dish/section text happens inside each block
           component (dish.cshtml / menuSection.cshtml), not here, since the
           "today's special" badge and spice-level label in dish.cshtml ARE
           Dictionary-translated and must keep flowing with the page direction. *@
        @await Html.GetBlockGridHtmlAsync(Model, "dishes")
    </div>
</div>