@using BellaVista.Helpers
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "Master.cshtml";
    string lang = LanguageHelper.ResolveLangCode(Context);
    var culture = LanguageHelper.ToCultureInfo(lang);
    string Dict(string key) => Umbraco.GetDictionaryValue(key, culture);
}
@section Scripts {
    <script src="~/js/specials.js"></script>
}
<div class="main_bg" dir="ltr">
    <div class="container">
        <div class="main_grid">
            <div class="top_grid">
                <div class="col-md-10 span1_of_1">
                    <h3>Warum Gäste Bella Vista lieben</h3>
                    <p>Frische Pasta, ein Holzofen und eine Speisekarte, die sich mit den Jahreszeiten ändert - gekocht, wie unser Küchenteam es von zu Hause kennt.</p>
                </div>
                <div class="col-md-2 span1_of_2">
                    <a class="btn" href="/menu">@Dict("Home.ViewMenuBtn")</a>
                </div>
                <div class="clearfix"></div>
            </div>
            <div class="span_of_4">
                <div class="col-md-3 span1_of_4">
                    <div class="span4_of_list">
                        <span class="active"><i class="fa fa-cutlery"></i></span>
                        <h3>Täglich frische Pasta</h3>
                        <p>Jede Tagliatelle, jeder Raviolo und Gnocco wird jeden Morgen im Haus gerollt und geformt, nie tiefgefroren.</p>
                    </div>
                </div>
                <div class="col-md-3 span1_of_4">
                    <div class="span4_of_list">
                        <span><i class="fa fa-fire"></i></span>
                        <h3>Holzofen</h3>
                        <p>Unser Pizzaofen wurde aus Neapel importiert und läuft mit Buchenholz für die richtige knusprige Kruste.</p>
                    </div>
                </div>
                <div class="col-md-3 span1_of_4">
                    <div class="span4_of_list">
                        <span><i class="fa fa-leaf"></i></span>
                        <h3>Saisonale Karte</h3>
                        <p>Die Speisekarte ändert sich mit dem, was gerade frisch auf dem Markt ist - es gibt immer etwas Neues zu entdecken.</p>
                    </div>
                </div>
                <div class="col-md-3 span1_of_4">
                    <div class="span4_of_list">
                        <span><i class="fa fa-glass"></i></span>
                        <h3>Kleine Weingüter</h3>
                        <p>Unsere Weinkarte setzt auf kleine, familiengeführte italienische Weingüter statt große Handelsmarken.</p>
                    </div>
                </div>
                <div class="clearfix"></div>
            </div>
        </div>
    </div>
</div>

<div class="specials_bg">
    <div class="container">
        <div class="main slider_text texxt-center">
            <h4>@Dict("Home.SpecialsHeading")</h4>
            <p>@Dict("Home.SpecialsIntro")</p>
        </div>
        <!-- dir="ltr": the cards injected here by specials.js come from the REST API's
             seeded dish content (German-only, see README), not translated chrome -->
        <div id="specials-list" class="span_of_4" dir="ltr"></div>
        <div class="specials-loadmore">
            <button id="specials-load-more" class="btn" data-take="3">@Dict("Btn.LoadMore")</button>
            <p id="specials-empty" class="specials-empty" style="display:none;">@Dict("Home.SpecialsEmpty")</p>
        </div>
    </div>
</div>

<div class="main1_bg" dir="ltr">
    <div class="container">
        <div class="main slider_text texxt-center">
            <h4>Warum Bella Vista</h4>
            <p>Eine familiengeführte Küche, die seit 2014 die gleichen Rezepte kocht.</p>
        </div>
    </div>
</div>
<div class="main_btm" dir="ltr">
    <div class="container">
        <div class="main span_of_3">
            <div class="col-md-3 span1_of_3">
                <h4>Warum uns wählen?</h4>
                <ul class="list-unstyled nav_list">
                    <li><a href="/menu">Frische Pasta, jeden Morgen im Haus gemacht</a></li>
                    <li><a href="/menu">Holzofen, importiert aus Neapel</a></li>
                    <li><a href="/menu">Saisonale Karte, passend zum Markt</a></li>
                    <li><a href="/menu">Weinkarte mit kleinen Weingütern</a></li>
                    <li><a href="/gallery">Ein Gastraum und eine Terrasse, die dazu passen</a></li>
                </ul>
            </div>
            <div class="col-md-6 span1_of_3">
                <h5>Bella Vista wird seit 2014 von der Familie Moretti geführt. <span>Die Küche folgt noch immer den Rezepten von Nonna Moretti</span>, und die Pasta wird jeden einzelnen Morgen frisch gerollt.</h5>
            </div>
            <div class="col-md-3 span1_of_3">
                <h4>Was Gäste sagen</h4>
                <div class="clients">
                    <p>"Die beste Tagliatelle al Tartufo, die ich außerhalb Italiens gegessen habe. Wir kommen jeden Monat wieder." - ein Stammgast</p>
                </div>
            </div>
            <div class="clearfix"></div>
        </div>
        <div class="cau_hide">
            <div class="cursual">
                <h4>Was unsere Gäste sagen<span class="line"></span></h4>
            </div>
            <div id="owl-demo" class="owl-carousel">
                <div class="item">
                    <div class="cau_left">
                        <img class="lazyOwl" data-src="/images/placeholders/avatar-1.svg" alt="Gast">
                        <p>"Die beste Holzofenpizza der Stadt." - Anna</p>
                    </div>
                </div>
                <div class="item">
                    <div class="cau_left">
                        <img class="lazyOwl" data-src="/images/placeholders/avatar-2.svg" alt="Gast">
                        <p>"Gemütliche Terrasse, wunderbares Tiramisù." - Jonas</p>
                    </div>
                </div>
                <div class="item">
                    <div class="cau_left">
                        <img class="lazyOwl" data-src="/images/placeholders/avatar-3.svg" alt="Gast">
                        <p>"Unser Stammlokal für jeden Jahrestag." - Sara &amp; Tom</p>
                    </div>
                </div>
                <div class="item">
                    <div class="cau_left">
                        <img class="lazyOwl" data-src="/images/placeholders/avatar-4.svg" alt="Gast">
                        <p>"Frisch, saisonal, und das Personal kennt deinen Namen." - Karim</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>