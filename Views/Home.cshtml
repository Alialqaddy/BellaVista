@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "Master.cshtml";
}
@section Scripts {
    <script src="~/js/specials.js"></script>
}
<div class="main_bg">
    <div class="container">
        <div class="main_grid">
            <div class="top_grid">
                <div class="col-md-10 span1_of_1">
                    <h3>why guests love bella vista</h3>
                    <p>Fresh pasta, a wood-fired oven and a menu that changes with the seasons - cooked the way our kitchen team learned it at home.</p>
                </div>
                <div class="col-md-2 span1_of_2">
                    <a class="btn" href="/menu">view menu</a>
                </div>
                <div class="clearfix"></div>
            </div>
            <div class="span_of_4">
                <div class="col-md-3 span1_of_4">
                    <div class="span4_of_list">
                        <span class="active"><i class="fa fa-cutlery"></i></span>
                        <h3>fresh pasta daily</h3>
                        <p>Every tagliatelle, raviolo and gnocco is rolled and shaped in-house each morning, never frozen.</p>
                    </div>
                </div>
                <div class="col-md-3 span1_of_4">
                    <div class="span4_of_list">
                        <span><i class="fa fa-fire"></i></span>
                        <h3>wood-fired oven</h3>
                        <p>Our pizza oven was imported from Naples and runs on beechwood for a proper charred crust.</p>
                    </div>
                </div>
                <div class="col-md-3 span1_of_4">
                    <div class="span4_of_list">
                        <span><i class="fa fa-leaf"></i></span>
                        <h3>seasonal menu</h3>
                        <p>The menu changes with what's fresh at the market, so there's always something new to try.</p>
                    </div>
                </div>
                <div class="col-md-3 span1_of_4">
                    <div class="span4_of_list">
                        <span><i class="fa fa-glass"></i></span>
                        <h3>small producers</h3>
                        <p>Our wine list is built around small, family-run Italian vineyards rather than big commercial labels.</p>
                    </div>
                </div>
                <div class="clearfix"></div>
            </div>
        </div>
    </div>
</div>

<div class="specials_bg">
    <div class="container">
        <div class="main slider_text texxt-center">
            <h4>today's specials</h4>
            <p>Loaded live from the kitchen via our REST API - no page reload needed.</p>
        </div>
        <div id="specials-list" class="span_of_4"></div>
        <div class="specials-loadmore">
            <button id="specials-load-more" class="btn" data-take="3">load more</button>
            <p id="specials-empty" class="specials-empty" style="display:none;">That's everything on today's specials board.</p>
        </div>
    </div>
</div>

<div class="main1_bg">
    <div class="container">
        <div class="main slider_text texxt-center">
            <h4>why bella vista</h4>
            <p>A family-run kitchen, cooking the same recipes since 2014.</p>
        </div>
    </div>
</div>
<div class="main_btm">
    <div class="container">
        <div class="main span_of_3">
            <div class="col-md-3 span1_of_3">
                <h4>why choose us?</h4>
                <ul class="list-unstyled nav_list">
                    <li><a href="/menu">Fresh pasta made in-house every morning</a></li>
                    <li><a href="/menu">Wood-fired oven imported from Naples</a></li>
                    <li><a href="/menu">A seasonal menu that changes with the market</a></li>
                    <li><a href="/menu">A wine list built around small producers</a></li>
                    <li><a href="/gallery">A dining room and terrace to match</a></li>
                </ul>
            </div>
            <div class="col-md-6 span1_of_3">
                <h5>Bella Vista has been run by the Moretti family since 2014. <span>The kitchen still follows Nonna Moretti's recipes</span>, and the pasta is still rolled fresh every single morning.</h5>
            </div>
            <div class="col-md-3 span1_of_3">
                <h4>what guests say</h4>
                <div class="clients">
                    <p>"Best tagliatelle al tartufo I've had outside of Italy. We come back every month." - a regular guest</p>
                </div>
            </div>
            <div class="clearfix"></div>
        </div>
        <div class="cau_hide">
            <div class="cursual">
                <h4>what our guests say<span class="line"></span></h4>
            </div>
            <div id="owl-demo" class="owl-carousel">
                <div class="item">
                    <div class="cau_left">
                        <img class="lazyOwl" data-src="/images/c1.png" alt="Guest">
                        <p>"The wood-fired pizza is the best in town." - Anna</p>
                    </div>
                </div>
                <div class="item">
                    <div class="cau_left">
                        <img class="lazyOwl" data-src="/images/c2.png" alt="Guest">
                        <p>"Cosy terrace, wonderful tiramisù." - Jonas</p>
                    </div>
                </div>
                <div class="item">
                    <div class="cau_left">
                        <img class="lazyOwl" data-src="/images/c3.png" alt="Guest">
                        <p>"Our go-to for every anniversary dinner." - Sara &amp; Tom</p>
                    </div>
                </div>
                <div class="item">
                    <div class="cau_left">
                        <img class="lazyOwl" data-src="/images/c4.png" alt="Guest">
                        <p>"Fresh, seasonal, and the staff remember your name." - Karim</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>