@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "Master.cshtml";
    string heroHeading = Model.Value<string>("heroHeading") ?? Model.Name;
    bool showContactForm = Model.Value<bool>("showContactForm");
}
<div class="main_bg">
    <div class="container">
        <div class="main_grid1">
            <h3 class="style pull-left">@heroHeading</h3>
            <ol class="breadcrumb pull-right">
                <li><a href="/">Home</a></li>
                <li class="active">@heroHeading</li>
            </ol>
            <div class="clearfix"></div>
        </div>
    </div>
</div>
<div class="main_btm1">
    <div class="container">
        <div class="main about span_of_3">
            @Html.Raw(Model.Value<string>("bodyText"))
        </div>

        @if (showContactForm)
        {
            <div class="contact">
                <iframe width="100%" height="350" frameborder="0" scrolling="no" title="Map to Bella Vista"
                        src="https://maps.google.com/maps?q=Saarbr%C3%BCcken&t=&z=13&ie=UTF8&iwloc=&output=embed"></iframe>
                <div class="contact_main">
                    <div class="col-md-8">
                        <div class="contact-form">
                            <h2>Request a Table</h2>
                            @if (TempData["ReservationSent"] != null)
                            {
                                <p class="reservation-success">Thanks - your reservation request has been sent, we'll confirm by phone or email shortly.</p>
                            }
                            @using (Html.BeginUmbracoForm<BellaVista.Controllers.Surface.ContactSurfaceController>("HandleReservation"))
                            {
                                <input type="text" name="Name" placeholder="Name" required />
                                <input type="email" name="Email" placeholder="Email" required />
                                <input type="text" name="Phone" placeholder="Phone" />
                                <input type="datetime-local" name="RequestedDateTime" />
                                <textarea name="Message" placeholder="Number of guests, any requests..."></textarea>
                                <span><input type="submit" value="submit request"></span>
                            }
                        </div>
                    </div>
                    <div class="clearfix"></div>
                </div>
            </div>
        }
    </div>
</div>