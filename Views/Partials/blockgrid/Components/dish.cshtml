@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Core.Models.PublishedContent
@using BellaVista.Helpers
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockGridItem>
@{
    var content = Model.Content;
    var image = content.Value<MediaWithCrops>("image");
    int spiceLevel = content.Value<int>("spiceLevel");
    bool isSpecial = content.Value<bool>("isTodaysSpecial");
    string lang = LanguageHelper.ResolveLangCode(Context);
    var culture = LanguageHelper.ToCultureInfo(lang);
    string Dict(string key) => Umbraco.GetDictionaryValue(key, culture);
}
<div class="dish-card">
    @if (isSpecial)
    {
        <span class="dish-badge">@Dict("Menu.TodaysSpecial")</span>
    }
    @if (image != null)
    {
        <img src="@image.Content.Url()" alt="@(content.Value<string>("dishName"))" class="img-responsive" />
    }
    <div class="dish-card-body">
        @* dir="ltr": dish name/description/price are seeded content (German/Italian, see
           README), never re-translated per culture - the "today's special" badge above and
           the spice-level label below ARE Dictionary-translated, so they stay outside this. *@
        <div dir="ltr">
            <div class="dish-card-header">
                <h4>@(content.Value<string>("dishName"))</h4>
                <span class="dish-price">@(content.Value<string>("price"))</span>
            </div>
            <p class="dish-description">@(content.Value<string>("description"))</p>
        </div>
        <div class="spice-level" title="@(Dict("Menu.SpiceLevel")): @spiceLevel/3">
            @for (int i = 1; i <= 3; i++)
            {
                <i class="fa fa-fire @(i <= spiceLevel ? "spice-active" : "spice-inactive")"></i>
            }
        </div>
    </div>
</div>
