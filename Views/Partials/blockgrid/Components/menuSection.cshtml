@using Umbraco.Cms.Core.Models.Blocks
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockGridItem>
@{
    var content = Model.Content;
}
<div class="menu-section">
    @* dir="ltr": section titles (Vorspeisen/Hauptgerichte/...) are seeded content, not
       Dictionary-translated chrome - see README on multilingual scope. *@
    <h3 class="menu-section-title" dir="ltr">@(content.Value<string>("sectionTitle"))</h3>
    <div class="menu-section-dishes">
        @await Html.GetBlockGridItemAreasHtmlAsync(Model)
    </div>
</div>
