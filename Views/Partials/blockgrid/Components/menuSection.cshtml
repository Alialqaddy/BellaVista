@using Umbraco.Cms.Core.Models.Blocks
@using BellaVista.Helpers
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockGridItem>
@{
    var content = Model.Content;
    string lang = LanguageHelper.ResolveLangCode(Context);
    string sectionTitle = LanguageHelper.Pick(lang, content.Value<string>("sectionTitle"), content.Value<string>("sectionTitleEn"), content.Value<string>("sectionTitleAr"));
}
<div class="menu-section">
    <h3 class="menu-section-title">@sectionTitle</h3>
    <div class="menu-section-dishes">
        @await Html.GetBlockGridItemAreasHtmlAsync(Model)
    </div>
</div>
