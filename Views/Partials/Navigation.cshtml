@using BellaVista.Helpers
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@*
    Dynamic navigation (chapter 4, Übung 4): a plain Partial View, not a macro - it walks
    the content tree itself and needs no editor-supplied parameters. Respects the built-in
    "hide from navigation" flag (umbracoNaviHide) on every node, and skips the technical
    Login/Members-only pages since they're not meant to show up as nav items.
*@
@{
    string lang = LanguageHelper.ResolveLangCode(Context);
    var culture = LanguageHelper.ToCultureInfo(lang);
    string Dict(string key) => Umbraco.GetDictionaryValue(key, culture);
    string activate = Model.Root().Id == Model.Id ? "activate" : "";

    var hiddenNames = new[] { "Login", "Members Only" };

    bool ShowInNav(IPublishedContent node) =>
        !node.Value<bool>("umbracoNaviHide") && !hiddenNames.Contains(node.Name);
}
<nav>
    <ul class="menu list-unstyled">
        <li class="@activate"><a href="/">@Dict("Nav.Home")</a></li>
        @foreach (var navItem in Model.Root().Children().Where(ShowInNav))
        {
            string itemActive = navItem.Id == Model.Id || Model.Ancestors().Any(a => a.Id == navItem.Id) ? "activate" : "";
            string label = navItem.ContentType.Alias switch
            {
                "contentPage" when navItem.Name == "About Us" => Dict("Nav.About"),
                "contentPage" when navItem.Name == "Contact" => Dict("Nav.Contact"),
                "contentPage" when navItem.Name == "Loyal Guests" => Dict("Nav.LoyalGuests"),
                "menuPage" => Dict("Nav.Menu"),
                "galleryPage" => Dict("Nav.Gallery"),
                "newsPage" => Dict("Nav.News"),
                _ => navItem.Name,
            };
            <li class="@itemActive"><a href="@navItem.Url()">@label</a></li>
        }
    </ul>
</nav>
