@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Core.Models.PublishedContent
@using BellaVista.Helpers
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockListItem>
@inject IVariationContextAccessor VariationContextAccessor
@{
    var content = Model.Content;
    var image = content.Value<MediaWithCrops>("image");
    string category = content.Value<string>("category") ?? "";
    string categorySlug = category.ToLowerInvariant();
    string lang = LanguageHelper.ResolveLangCode(VariationContextAccessor);
    var culture = LanguageHelper.ToCultureInfo(lang);
    string Dict(string key) => Umbraco.GetDictionaryValue(key, culture);
    string caption = LanguageHelper.Pick(lang, content.Value<string>("caption"), content.Value<string>("captionEn"), content.Value<string>("captionAr"));

    // The stored category value ("Starter"/"Main"/...) also drives the mixitup filter
    // (bare category class name below, matching the theme's own portfolio.html markup
    // exactly - a "gallery-" prefixed class here previously broke the filter buttons
    // since mixitup matches on the plain class name, not data-cat); the VISIBLE label
    // reuses the same Dictionary Items as the Gallery filter buttons, so it's translated too.
    string categoryLabel = categorySlug switch
    {
        "starter" => Dict("Gallery.FilterStarters"),
        "main" => Dict("Gallery.FilterMains"),
        "dessert" => Dict("Gallery.FilterDesserts"),
        "drink" => Dict("Gallery.FilterDrinks"),
        _ => category,
    };
}
<div class="portfolio @categorySlug" data-cat="@categorySlug">
    <div class="portfolio-wrapper">
        @if (image != null)
        {
            <div class="fancyDemo">
                <a rel="group" title="@caption" href="@image.Content.Url()">
                    <img src="@image.Content.Url()" alt="@caption" class="img-responsive" />
                </a>
            </div>
        }
        <div class="label">
            <div class="label-text">
                <span class="text-category">@categoryLabel</span>
            </div>
            <div class="label-bg"></div>
        </div>
    </div>
</div>
