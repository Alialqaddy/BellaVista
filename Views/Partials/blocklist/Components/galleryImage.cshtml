@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Core.Models.PublishedContent
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockListItem>
@{
    var content = Model.Content;
    var image = content.Value<MediaWithCrops>("image");
    string category = content.Value<string>("category") ?? "";
}
<div class="portfolio gallery-@category.ToLowerInvariant()" data-cat="@category.ToLowerInvariant()">
    <div class="portfolio-wrapper">
        @if (image != null)
        {
            <div class="fancyDemo">
                <a rel="group" title="@(content.Value<string>("caption"))" href="@image.Content.Url()">
                    <img src="@image.Content.Url()" alt="@(content.Value<string>("caption"))" class="img-responsive" />
                </a>
            </div>
        }
        <div class="label">
            <div class="label-text">
                <span class="text-category">@category</span>
            </div>
            <div class="label-bg"></div>
        </div>
    </div>
</div>
