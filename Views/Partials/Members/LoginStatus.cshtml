@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Cms.Core.Security
@using BellaVista.Composing
@using BellaVista.Helpers
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@inject IMemberManager MemberManager
@inject IVariationContextAccessor VariationContextAccessor
@{
    string lang = LanguageHelper.ResolveLangCode(VariationContextAccessor);
    var culture = LanguageHelper.ToCultureInfo(lang);
    string Dict(string key) => Umbraco.GetDictionaryValue(key, culture);
    bool loggedIn = MemberManager.IsLoggedIn();
    string? memberName = loggedIn ? (await MemberManager.GetCurrentMemberAsync())?.Name : null;
}
<div class="login-status">
    @if (loggedIn)
    {
        <span class="login-status-name" dir="ltr">@memberName</span>
        @using (Html.BeginUmbracoForm<BellaVista.Controllers.Surface.MemberSurfaceController>("HandleLogout"))
        {
            <button type="submit" class="login-status-link">@Dict("Logout.Action")</button>
        }
    }
    else
    {
        <a class="login-status-link" href="@Umbraco.Content(ContentKeys.Login)?.Url()">@Dict("Login.Title")</a>
    }
</div>
